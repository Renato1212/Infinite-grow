# Postgres connection used by Drizzle. For Supabase use the session pooler URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Public Supabase config (auth + storage)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only used by scripts/ (migrations, seed). Never imported by app code.
SUPABASE_SERVICE_ROLE_KEY=
